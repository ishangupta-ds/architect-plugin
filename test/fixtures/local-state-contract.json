{
  "_comment": "The publish contract for PUT /api/local-state, shared by the server, the collector CLI and the plugin (reviewer-context C16-C18). Every `valid` payload must be accepted and every `invalid` one refused with an error that starts with `error`. Keep this file byte-identical in each repo that validates against it.",
  "valid": [
    { "name": "minimal", "payload": { "repo": { "provider": "github", "ownerRepo": "acme/widgets" }, "branch": "main", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": [] } },
    { "name": "full", "payload": { "repo": { "provider": "gitlab", "ownerRepo": "acme/sub/widgets" }, "branch": "feature/login-fix", "headSha": "0123456789abcdef0123456789abcdef01234567", "baseSha": "89abcdef0123456789abcdef0123456789abcdef", "mergeBaseSha": "fedcba9876543210fedcba9876543210fedcba98", "workingTreeDirty": true, "ahead": 3, "behind": 12, "paths": ["src/a.ts", "src/b/c.ts", "README.md", "src/a.ts"], "pathsTruncated": false, "client": "architect-plugin/0.4.0" } },
    { "name": "unicode and dotted names", "payload": { "repo": { "provider": "github", "ownerRepo": "my-org/my.repo_2" }, "branch": "fix/ünï-bränch", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": ["docs/résumé.md", ".github/workflows/ci.yml", "a..b/c.ts", "weird name with spaces.txt"] } }
  ],
