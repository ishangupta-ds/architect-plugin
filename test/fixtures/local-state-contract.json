    { "name": "unknown provider", "payload": { "repo": { "provider": "bitbucket", "ownerRepo": "a/b" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": [] }, "error": "repo.provider" },
    { "name": "repo is a filesystem path", "payload": { "repo": { "provider": "github", "ownerRepo": "/home/me/repo" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": [] }, "error": "repo.ownerRepo" },
    { "name": "repo with a URL", "payload": { "repo": { "provider": "github", "ownerRepo": "https://github.com/a/b" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": [] }, "error": "repo.ownerRepo" },
    { "name": "short sha", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x", "headSha": "abc123", "workingTreeDirty": false, "paths": [] }, "error": "headSha" },
    { "name": "uppercase sha", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x", "headSha": "0123456789ABCDEF0123456789ABCDEF01234567", "workingTreeDirty": false, "paths": [] }, "error": "headSha" },
    { "name": "empty branch", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": [] }, "error": "branch" },
    { "name": "branch with a control character", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x\ny", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": [] }, "error": "branch" },
    { "name": "dirty is a string", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": "yes", "paths": [] }, "error": "workingTreeDirty" },
    { "name": "negative ahead", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "ahead": -1, "paths": [] }, "error": "ahead" },
    { "name": "paths missing", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false }, "error": "paths" },
