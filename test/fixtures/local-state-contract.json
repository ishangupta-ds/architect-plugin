    { "name": "dot segment", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": ["src/./a.ts"] }, "error": "paths.0" },
    { "name": "leading ./", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": ["./a.ts"] }, "error": "paths.0" },
    { "name": "backslash", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": ["src\\a.ts"] }, "error": "paths.0" },
    { "name": "NUL byte", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": ["a\u0000b.ts"] }, "error": "paths.0" },
    { "name": "empty segment", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": ["src//a.ts"] }, "error": "paths.0" },
    { "name": "trailing slash", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": ["src/"] }, "error": "paths.0" },
    { "name": "path is a number", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": [42] }, "error": "paths.0" },
    { "name": "empty path", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": [""] }, "error": "paths.0" },
    { "name": "client with a control character", "payload": { "repo": { "provider": "github", "ownerRepo": "a/b" }, "branch": "x", "headSha": "0123456789abcdef0123456789abcdef01234567", "workingTreeDirty": false, "paths": [], "client": "a\tb" }, "error": "client" }
  ]
